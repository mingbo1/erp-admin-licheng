
.page.data-v-57280228 { padding-bottom: 130rpx; min-height: 100vh; background: #f5f7fa;
}

/* 轮播图 */
.banner-wrap.data-v-57280228 { padding: 20rpx 20rpx 0;
}

/* 搜索栏 */
.search-wrap.data-v-57280228 { padding: 20rpx 20rpx 0; background: #f5f7fa;
}

/* 分类 */
.cate-scroll.data-v-57280228 { padding: 20rpx 20rpx; background: #f5f7fa;
}
.cate-inner.data-v-57280228 { display: flex; align-items: center; white-space: nowrap; gap: 12rpx;
}
.cate-item.data-v-57280228 {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #606266;
  background: #fff;
  border-radius: 40rpx;
  white-space: nowrap;
  font-weight: 500;
  transition: all 0.2s;
}
.cate-item.active.data-v-57280228 {
  color: #fff;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  font-weight: 600;
}

/* 商品网格 - 两列 */
.goods-grid.data-v-57280228 {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}
.goods-card.data-v-57280228 {
  width: 48%;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  transition: -webkit-transform 0.15s;
  transition: transform 0.15s;
  transition: transform 0.15s, -webkit-transform 0.15s;
}
.goods-card.data-v-57280228:nth-child(odd) { margin-right: 4%;
}
.card-hover.data-v-57280228 { -webkit-transform: scale(0.97); transform: scale(0.97);
}
.card-img.data-v-57280228 {
  width: 100%;
  aspect-ratio: 1;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.card-body.data-v-57280228 {
  padding: 16rpx 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.card-name.data-v-57280228 { font-size: 26rpx; color: #303133; font-weight: 500; line-height: 1.4;
}
.card-spec.data-v-57280228 {
}
.card-spec-text.data-v-57280228 { font-size: 22rpx; color: #c0c4cc;
}
.card-bottom.data-v-57280228 { display: flex; align-items: center; justify-content: space-between; margin-top: 4rpx;
}
.card-price.data-v-57280228 { font-size: 32rpx; color: #f56c6c; font-weight: 700;
}
.card-actions.data-v-57280228 { display: flex; align-items: center;
}
.card-add-btn.data-v-57280228 {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-soldout.data-v-57280228 { font-size: 22rpx; color: #c0c4cc;
}

/* 骨架屏 */
.skeleton-card-img.data-v-57280228 {
  width: 100%; aspect-ratio: 1;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  -webkit-animation: shimmer-data-v-57280228 1.5s infinite;
          animation: shimmer-data-v-57280228 1.5s infinite;
}
.skeleton-line.data-v-57280228 {
  height: 26rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  -webkit-animation: shimmer-data-v-57280228 1.5s infinite;
          animation: shimmer-data-v-57280228 1.5s infinite;
  border-radius: 13rpx;
}
@-webkit-keyframes shimmer-data-v-57280228 {
0% { background-position: 200% 0;
}
100% { background-position: -200% 0;
}
}
@keyframes shimmer-data-v-57280228 {
0% { background-position: 200% 0;
}
100% { background-position: -200% 0;
}
}

