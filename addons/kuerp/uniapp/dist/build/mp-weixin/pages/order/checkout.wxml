<view class="page data-v-561e06f3"><view class="section-card data-v-561e06f3" hover-class="card-hover" data-event-opts="{{[['tap',[['selectAddress',['$event']]]]]}}" bindtap="__e"><block wx:if="{{address}}"><view class="address-area data-v-561e06f3"><view class="address-top data-v-561e06f3"><text class="address-name data-v-561e06f3">{{address.first_connect_name}}</text><text class="address-mobile data-v-561e06f3">{{address.first_connect_mobile}}</text><block wx:if="{{address.is_first==1}}"><u-tag vue-id="028b5e34-1" text="默认" type="primary" size="mini" plain="{{true}}" class="data-v-561e06f3" bind:__l="__l"></u-tag></block></view><text class="address-detail data-v-561e06f3">{{address.connect_address}}</text></view></block><block wx:else><view class="address-empty data-v-561e06f3"><u-icon vue-id="028b5e34-2" name="plus-circle" size="36" color="#c0c4cc" class="data-v-561e06f3" bind:__l="__l"></u-icon><text class="address-empty-text data-v-561e06f3">请添加收货地址</text></view></block><u-icon class="address-arrow data-v-561e06f3" vue-id="028b5e34-3" name="arrow-right" size="28" color="#c0c4cc" bind:__l="__l"></u-icon></view><view class="section-card data-v-561e06f3"><view class="section-header data-v-561e06f3"><text class="section-title data-v-561e06f3">商品清单</text><u-tag vue-id="028b5e34-4" text="{{itemCount+'件'}}" type="info" size="mini" plain="{{true}}" class="data-v-561e06f3" bind:__l="__l"></u-tag></view><u-divider vue-id="028b5e34-5" half-width="20" hairline="{{true}}" class="data-v-561e06f3" bind:__l="__l"></u-divider><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i0__"><view class="goods-item data-v-561e06f3"><view class="goods-img data-v-561e06f3"><block wx:if="{{item.$orig.goods_image}}"><image style="width:100%;height:100%;border-radius:8rpx;" src="{{item.m0}}" mode="aspectFill" class="data-v-561e06f3"></image></block><block wx:else><u-icon vue-id="{{'028b5e34-6-'+__i0__}}" name="shopping-cart" size="32" color="#c0c4cc" class="data-v-561e06f3" bind:__l="__l"></u-icon></block></view><view class="goods-info data-v-561e06f3"><text class="goods-name u-line-1 data-v-561e06f3">{{item.$orig.goods_name||item.$orig.goods.goods_name}}</text><block wx:if="{{item.$orig.attr_name||item.$orig.unit_name}}"><text class="goods-spec data-v-561e06f3">{{(item.$orig.unitName||item.$orig.unit_name)+(item.$orig.attr_name?' / '+item.$orig.attr_name:'')}}</text></block><text class="goods-price-tag data-v-561e06f3">{{"¥"+(item.$orig.unit_price||item.$orig.show_price||item.$orig.goods.sale_price)}}</text></view><view class="goods-right data-v-561e06f3"><text class="goods-qty data-v-561e06f3">{{"× "+item.$orig.quantity}}</text><text class="goods-total data-v-561e06f3">{{"¥"+item.m1}}</text></view></view></block><view class="total-row data-v-561e06f3"><text class="data-v-561e06f3">商品合计</text><text class="total-price data-v-561e06f3">{{"¥"+totalAmount}}</text></view></view><view class="section-card data-v-561e06f3"><view class="section-header data-v-561e06f3"><text class="section-title data-v-561e06f3">订单备注</text></view><u--textarea bind:input="__e" vue-id="028b5e34-7" placeholder="选填，如有特殊要求请在此备注" maxlength="200" count="{{true}}" height="120" value="{{remark}}" data-event-opts="{{[['^input',[['__set_model',['','remark','$event',[]]]]]]}}" class="data-v-561e06f3" bind:__l="__l"></u--textarea></view><view class="submit-bar safe-area-bottom data-v-561e06f3"><view class="submit-total data-v-561e06f3"><text class="submit-label data-v-561e06f3">实付</text><text class="submit-price data-v-561e06f3">{{"¥"+totalAmount}}</text></view><u-button class="submit-btn data-v-561e06f3" vue-id="028b5e34-8" type="primary" shape="circle" loading="{{submitting}}" disabled="{{submitting||!address}}" data-event-opts="{{[['^click',[['submitOrder']]]]}}" bind:click="__e" bind:__l="__l" vue-slots="{{['default']}}">{{''+(submitting?'提交中...':'提交订单')+''}}</u-button></view></view>