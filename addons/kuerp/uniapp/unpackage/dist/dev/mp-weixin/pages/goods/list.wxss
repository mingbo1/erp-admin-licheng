
.page.data-v-b227d520 {
  padding-bottom: 130rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

/* 搜索栏（吸顶） */
.search-bar.data-v-b227d520 {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 20rpx 20rpx 16rpx;
  background: #f5f7fa;
}

/* 分类筛选 chips */
.cate-scroll.data-v-b227d520 {
  background: #fff;
  white-space: nowrap;
}
.cate-chips.data-v-b227d520 {
  display: inline-flex;
  padding: 20rpx 24rpx;
}
.cate-chip.data-v-b227d520 {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: #606266;
  background: #f5f7fa;
  border-radius: 30rpx;
  transition: all 0.2s;
}
.cate-chip.active.data-v-b227d520 {
  color: #fff;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  font-weight: 500;
}

/* 商品网格 - 两列 */
.goods-grid.data-v-b227d520 {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 16rpx 0;
}
.goods-card.data-v-b227d520 {
  width: 48%;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  transition: -webkit-transform 0.15s;
  transition: transform 0.15s;
  transition: transform 0.15s, -webkit-transform 0.15s;
}
.goods-card.data-v-b227d520:nth-child(odd) {
  margin-right: 4%;
}
.card-hover.data-v-b227d520 {
  -webkit-transform: scale(0.97);
          transform: scale(0.97);
}
.card-img.data-v-b227d520 {
  width: 100%;
  aspect-ratio: 1;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.card-body.data-v-b227d520 {
  padding: 16rpx 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.card-name.data-v-b227d520 {
  font-size: 26rpx;
  color: #303133;
  font-weight: 500;
  line-height: 1.4;
}
.card-spec.data-v-b227d520 {}
.card-spec-text.data-v-b227d520 {
  font-size: 22rpx;
  color: #c0c4cc;
}
.card-bottom.data-v-b227d520 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}
.card-price.data-v-b227d520 {
  font-size: 32rpx;
  color: #f56c6c;
  font-weight: 700;
}
.card-actions.data-v-b227d520 {
  display: flex;
  align-items: center;
}
.card-add-btn.data-v-b227d520 {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-soldout.data-v-b227d520 {
  font-size: 22rpx;
  color: #c0c4cc;
}

/* 骨架屏 */
.skeleton-card-img.data-v-b227d520 {
  width: 100%;
  aspect-ratio: 1;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  -webkit-animation: shimmer-data-v-b227d520 1.5s infinite;
          animation: shimmer-data-v-b227d520 1.5s infinite;
}
.skeleton-line.data-v-b227d520 {
  height: 26rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  -webkit-animation: shimmer-data-v-b227d520 1.5s infinite;
          animation: shimmer-data-v-b227d520 1.5s infinite;
  border-radius: 13rpx;
}
@-webkit-keyframes shimmer-data-v-b227d520 {
0% {
    background-position: 200% 0;
}
100% {
    background-position: -200% 0;
}
}
@keyframes shimmer-data-v-b227d520 {
0% {
    background-position: 200% 0;
}
100% {
    background-position: -200% 0;
}
}

