
.page.data-v-c64697c0 { padding-bottom: 140rpx; min-height: 100vh; background: #f5f7fa;
}
.card-hover.data-v-c64697c0 { -webkit-transform: scale(0.98); transform: scale(0.98);
}
.section-card.data-v-c64697c0 {
  background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; transition: -webkit-transform 0.15s; transition: transform 0.15s; transition: transform 0.15s, -webkit-transform 0.15s;
  overflow: hidden;      /* 防止内容溢出圆角 */
}
.section-header.data-v-c64697c0 { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx;
}
.section-title.data-v-c64697c0 { font-size: 28rpx; font-weight: 600; color: #303133;
}
/* 地址 */
.address-area.data-v-c64697c0 { display: flex; align-items: center;
}
.address-info.data-v-c64697c0 { flex: 1; min-width: 0;
}
.address-top.data-v-c64697c0 { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx;
}
.address-name.data-v-c64697c0 { font-size: 30rpx; font-weight: 600; color: #303133; flex-shrink: 0;
}
.address-mobile.data-v-c64697c0 { font-size: 26rpx; color: #606266; flex-shrink: 0;
}
.address-detail.data-v-c64697c0 { font-size: 26rpx; color: #909399; line-height: 1.5;
}
.address-empty.data-v-c64697c0 { display: flex; align-items: center; padding: 20rpx 0;
}
.address-empty-info.data-v-c64697c0 { display: flex; align-items: center; gap: 12rpx; flex: 1; min-width: 0;
}
.address-empty-text.data-v-c64697c0 { font-size: 26rpx; color: #c0c4cc;
}
.address-arrow.data-v-c64697c0 { flex-shrink: 0; margin-left: 16rpx;
}
/* 商品 */
.goods-item.data-v-c64697c0 { display: flex; align-items: center; padding: 16rpx 0;
}
.goods-item + .goods-item.data-v-c64697c0 { border-top: 1rpx solid #f5f7fa;
}
.goods-img.data-v-c64697c0 {
  width: 72rpx; height: 72rpx; background: #f5f7fa; border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 16rpx; flex-shrink: 0; overflow: hidden;
}
.goods-info.data-v-c64697c0 { flex: 1;
}
.goods-name.data-v-c64697c0 { font-size: 26rpx; color: #303133; display: block;
}
.goods-spec.data-v-c64697c0 { font-size: 22rpx; color: #c0c4cc; margin-top: 4rpx; display: block;
}
.goods-price-tag.data-v-c64697c0 { font-size: 22rpx; color: #909399; margin-top: 4rpx; display: block;
}
.goods-right.data-v-c64697c0 { text-align: right; margin-left: 16rpx;
}
.goods-qty.data-v-c64697c0 { font-size: 24rpx; color: #909399; display: block;
}
.goods-total.data-v-c64697c0 { font-size: 26rpx; color: #303133; font-weight: 500; margin-top: 4rpx; display: block;
}
.total-row.data-v-c64697c0 {
  display: flex; justify-content: space-between; padding-top: 16rpx; margin-top: 8rpx;
  border-top: 2rpx solid #f5f7fa; font-size: 28rpx; color: #303133; font-weight: 600;
}
.total-row .total-price.data-v-c64697c0 { color: #f56c6c; font-size: 32rpx;
}
/* 提交栏 */
.submit-bar.data-v-c64697c0 {
  position: fixed; bottom: 0; left: 0; right: 0; background: #fff;
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx; border-top: 1rpx solid #f2f2f2;
}
.submit-total.data-v-c64697c0 { display: flex; align-items: baseline; gap: 8rpx; width: 350rpx;
}
.submit-label.data-v-c64697c0 { font-size: 26rpx; color: #606266;
}
.submit-price.data-v-c64697c0 { font-size: 36rpx; color: #f56c6c; font-weight: 700;
}
.submit-btn.data-v-c64697c0 { width: 400rpx;
}

